@inject SecurityWebApp.Helpers.PasswordManager PasswordManager
@{
    ViewData["Title"] = "Create account";
    var rules = PasswordManager.Rules;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark">Create account</h2>
                    <p class="text-muted small mb-0">Sign up to get started</p>
                </div>

                <partial name="_Alerts" />

                <form method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="email" class="form-label text-secondary small fw-semibold">Email address</label>
                        <input type="email" class="form-control" id="email" name="email" required
                               autocomplete="email" placeholder="name@example.com">
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label text-secondary small fw-semibold">Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password" name="password" required
                                   minlength="@rules.RequiredLength" autocomplete="new-password" placeholder="Enter password">
                            <button class="btn btn-outline-secondary" type="button" data-toggle-password="password">Show</button>
                            <div class="invalid-feedback">Password must be at least @rules.RequiredLength characters long.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label text-secondary small fw-semibold">Confirm password</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required
                               minlength="@rules.RequiredLength" autocomplete="new-password" data-match="password"
                               placeholder="Confirm password">
                        <div class="invalid-feedback">Passwords do not match.</div>
                    </div>

                    <div class="border rounded p-3 mb-4 bg-light">
                        <div class="small fw-semibold text-secondary mb-2">Password must contain</div>
                        <partial name="_PasswordRules" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Create account</button>
                </form>

                <p class="text-center text-muted small mt-4 mb-0">
                    Already have an account?
                    <a asp-action="Login" class="text-decoration-none fw-semibold">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>
