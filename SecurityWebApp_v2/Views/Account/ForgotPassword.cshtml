@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark">Forgot your password?</h2>
                    <p class="text-muted small mb-0">
                        Enter your registered email address. We will send you a one-time SHA-1
                        verification code you can use to choose a new password.
                    </p>
                </div>

                <partial name="_Alerts" />

                <form method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="identifier" class="form-label text-secondary small fw-semibold">Email address</label>
                        <input type="email" class="form-control" id="identifier" name="identifier" required
                               autocomplete="email" placeholder="name@example.com">
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Send reset code</button>
                </form>

                <p class="text-center small mt-4 mb-0">
                    <a asp-action="Login" class="text-decoration-none">Back to sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>
