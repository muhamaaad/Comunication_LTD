@model SecurityWebApp.Models.User
@{
    ViewData["Title"] = "My profile";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 fw-bold mb-4">My profile</h1>

                <dl class="row mb-4">
                    <dt class="col-sm-4 fw-normal text-muted">Username</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Username</dd>

                    <dt class="col-sm-4 fw-normal text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 fw-normal text-muted">Role</dt>
                    <dd class="col-sm-8">@Model.Role</dd>

                    <dt class="col-sm-4 fw-normal text-muted">Member since</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>

                    @* Not a real product, only so the page looks like a customer area. *@
                    <dt class="col-sm-4 fw-normal text-muted">Your package</dt>
                    <dd class="col-sm-8">Home Plus &mdash; 500 Mbps</dd>
                </dl>

                <a class="btn btn-primary" asp-action="ChangePassword">Change password</a>
            </div>
        </div>
    </div>
</div>
