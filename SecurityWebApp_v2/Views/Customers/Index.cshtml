@model IEnumerable<SecurityWebApp.Models.Customer>
@{
    ViewData["Title"] = "Customers";
    var customers = Model.ToList();
    var newCustomerName = ViewBag.NewCustomerName as string;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">Customers</h1>
        <p class="text-muted small mb-0">Add a customer and it appears in the list below.</p>
    </div>
    <span class="text-muted small">@customers.Count customer(s)</span>
</div>

<partial name="_Alerts" />

@if (!string.IsNullOrEmpty(newCustomerName))
{
    <div class="alert alert-info" role="alert">
        @* Razor HTML-encodes this. The vulnerable build renders the same value raw. *@
        Added customer: <strong>@newCustomerName</strong>
    </div>
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h6 fw-semibold mb-0">Add customer</h2>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="name" class="form-label text-secondary small fw-semibold">Customer name</label>
                        <input type="text" class="form-control" id="name" name="name" required maxlength="150"
                               placeholder="Full name">
                        <div class="invalid-feedback">Customer name is required.</div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label text-secondary small fw-semibold">Email <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="email" class="form-control" id="email" name="email" maxlength="255"
                               placeholder="name@example.com">
                        <div class="invalid-feedback">Please enter a valid email address.</div>
                    </div>

                    <div class="mb-4">
                        <label for="phone" class="form-label text-secondary small fw-semibold">Phone <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="tel" class="form-control" id="phone" name="phone" maxlength="30"
                               pattern="[0-9+()\-\s]{6,30}" placeholder="+972 50 000 0000">
                        <div class="invalid-feedback">Please enter a valid phone number.</div>
                    </div>

                    <button type="submit" class="btn btn-primary fw-semibold px-4">Add customer</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="h6 fw-semibold mb-0">All customers</h2>
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="search" class="form-control form-control-sm search-input" name="q" value="@ViewBag.Query"
                           placeholder="Search name or email">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Added</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in customers)
                        {
                            <tr>
                                <td class="fw-semibold">@customer.Name</td>
                                <td class="text-muted small">@customer.Email</td>
                                <td class="text-muted small">@customer.Phone</td>
                                <td class="text-muted small">@customer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                        @if (customers.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No customers yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
