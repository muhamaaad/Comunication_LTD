@inject SecurityWebApp.Helpers.PasswordManager PasswordManager
@{
    // Rendered from the policy the server actually enforces, so the two cannot drift.
    var rules = PasswordManager.Rules;
}

<ul class="list-unstyled small text-muted mb-0">
    <li>At least @rules.RequiredLength characters</li>
    @if (rules.RequireUppercase)
    {
        <li>One uppercase letter (A-Z)</li>
    }
    @if (rules.RequireLowercase)
    {
        <li>One lowercase letter (a-z)</li>
    }
    @if (rules.RequireDigit)
    {
        <li>One digit (0-9)</li>
    }
    @if (rules.RequireSpecialCharacter)
    {
        <li>One special character from <code>@rules.AllowedSpecialCharacters</code></li>
    }
    @if (rules.PreventDictionary)
    {
        <li>Not a common dictionary password</li>
    }
    @if (rules.PasswordHistoryLimit > 0)
    {
        <li>Not one of the last @rules.PasswordHistoryLimit passwords used</li>
    }
</ul>
