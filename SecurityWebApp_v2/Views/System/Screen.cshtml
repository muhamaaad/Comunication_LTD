@inject SecurityWebApp.Helpers.PasswordManager PasswordManager
@inject Microsoft.Extensions.Options.IOptionsSnapshot<SecurityWebApp.Helpers.UsernameRules> UsernameOptions
@model IEnumerable<SecurityWebApp.Models.User>
@{
    ViewData["Title"] = "System screen";

    var users = Model.ToList();
    var rules = PasswordManager.Rules;
    var query = ViewBag.Query as string;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var matching = (int)ViewBag.Matching;
    var adminCount = (int)ViewBag.AdministratorCount;
    var currentUserId = ViewBag.CurrentUserId as int?;
    var newUsername = ViewBag.NewUsername as string;
    var usernameRules = UsernameOptions.Value;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h3 fw-bold mb-0">System screen</h1>
            <span class="badge text-bg-danger">Admin only</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Manage the users of the system.</p>
    </div>
    <div class="text-end">
        <div class="small fw-semibold text-secondary">Signed in as</div>
        <div class="text-muted small">@User.Identity!.Name</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(newUsername))
{
    @* Razor encodes this, so a username like "<script>..." is shown as text
       instead of running. This is the Stored XSS demo point. *@
    <div class="alert alert-info" role="alert">
        New user added: <strong>@newUsername</strong>
    </div>
}

<div class="d-flex align-items-center gap-3 small text-muted mb-3">
    <span><strong class="text-dark">@ViewBag.TotalUsers</strong> users</span>
    <span class="text-black-50">&bull;</span>
    <span><strong class="text-dark">@adminCount</strong> admin(s)</span>
    <span class="text-black-50">&bull;</span>
    <span><strong class="text-danger">@ViewBag.LockedUsers</strong> locked</span>
</div>

<ul class="nav nav-pills gap-2 mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#users" type="button" role="tab">Users</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#create" type="button" role="tab">Add user</button>
    </li>
</ul>

<div class="tab-content">

    <div class="tab-pane fade show active" id="users" role="tabpanel">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="h6 fw-semibold mb-0">All users</h2>
                <form asp-action="Screen" method="get" class="d-flex gap-2">
                    <input type="search" class="form-control form-control-sm search-input" name="q" value="@query"
                           placeholder="Search username or email...">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th class="text-center">Failed attempts</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            var isSelf = currentUserId == u.Id;
                            var isLastAdmin = u.Role == UserRole.Admin && adminCount == 1;

                            <tr>
                                <td class="text-muted">@u.Id</td>
                                <td>
                                    <div class="fw-semibold">
                                        @u.Username
                                        @if (isSelf)
                                        {
                                            <span class="badge text-bg-light border ms-1">you</span>
                                        }
                                    </div>
                                    @if (u.IsLocked)
                                    {
                                        <div class="text-danger small">
                                            Locked@(u.LockedUntil.HasValue
                                                ? " until " + u.LockedUntil.Value.ToLocalTime().ToString("HH:mm")
                                                : "")
                                        </div>
                                    }
                                </td>
                                <td class="text-muted small">@u.Email</td>
                                <td>
                                    @if (isSelf || isLastAdmin)
                                    {
                                        <span class="badge @(u.Role == UserRole.Admin ? "text-bg-danger" : "text-bg-secondary")">@u.Role</span>
                                    }
                                    else
                                    {
                                        <form asp-action="SetRole" method="post" class="d-inline js-autosubmit">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <select name="role" class="form-select form-select-sm role-select"
                                                    aria-label="Role for @u.Username">
                                                <option value="@UserRole.Regular" selected="@(u.Role == UserRole.Regular)">Regular</option>
                                                <option value="@UserRole.Admin" selected="@(u.Role == UserRole.Admin)">Admin</option>
                                            </select>
                                        </form>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (u.LoginAttempts >= rules.LoginAttemptLimit)
                                    {
                                        <span class="text-danger fw-semibold">@u.LoginAttempts</span>
                                    }
                                    else if (u.LoginAttempts > 0)
                                    {
                                        <span class="text-warning fw-semibold">@u.LoginAttempts</span>
                                    }
                                    else
                                    {
                                        @u.LoginAttempts
                                    }
                                </td>
                                <td class="text-end">
                                    @if (u.IsLocked)
                                    {
                                        <form asp-action="Unlock" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Unlock</button>
                                        </form>
                                    }
                                    @if (!isSelf && !isLastAdmin)
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              data-confirm="Delete @u.Username?">
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (users.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No users matched. Use the <strong>Add user</strong> tab to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <span class="text-muted small">Showing @users.Count of @matching users</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Screen" asp-route-q="@query" asp-route-page="@(page - 1)">Previous</a>
                        </li>
                        @for (var p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">
                                <a class="page-link" asp-action="Screen" asp-route-q="@query" asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Screen" asp-route-q="@query" asp-route-page="@(page + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="create" role="tabpanel">
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h2 class="h6 fw-semibold mb-0">Add a new user</h2>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label for="newUsername" class="form-label text-secondary small fw-semibold">Username</label>
                                <input type="text" class="form-control" id="newUsername" name="username" required
                                       minlength="@usernameRules.MinLength" maxlength="@usernameRules.MaxLength"
                                       placeholder="username">
                                <div class="invalid-feedback">
                                    Between @usernameRules.MinLength and @usernameRules.MaxLength characters.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="newEmail" class="form-label text-secondary small fw-semibold">Email address</label>
                                <input type="email" class="form-control" id="newEmail" name="email" required
                                       placeholder="name@@comltd.co.il">
                                <div class="invalid-feedback">Please enter a valid email address.</div>
                            </div>

                            <div class="mb-3">
                                <label for="newRole" class="form-label text-secondary small fw-semibold">Role</label>
                                <select class="form-select" id="newRole" name="role">
                                    <option value="@UserRole.Regular" selected>Regular</option>
                                    <option value="@UserRole.Admin">Admin</option>
                                </select>
                                <div class="form-text">Admins can reach this screen and manage every account.</div>
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label text-secondary small fw-semibold">Password</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="newPassword" name="password" required
                                           minlength="@rules.RequiredLength" placeholder="Enter password">
                                    <button class="btn btn-outline-secondary" type="button" data-toggle-password="newPassword">Show</button>
                                    <div class="invalid-feedback">Password must be at least @rules.RequiredLength characters long.</div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="confirmNewPassword" class="form-label text-secondary small fw-semibold">Confirm password</label>
                                <input type="password" class="form-control" id="confirmNewPassword" name="confirmPassword"
                                       required minlength="@rules.RequiredLength" data-match="newPassword"
                                       placeholder="Re-enter password">
                                <div class="invalid-feedback">Passwords do not match.</div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary fw-semibold px-4">Add user</button>
                                <button type="reset" class="btn btn-outline-secondary">Clear</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h2 class="h6 fw-semibold mb-0">Password must contain</h2>
                    </div>
                    <div class="card-body">
                        <partial name="_PasswordRules" />
                        <hr class="my-3">
                        <p class="text-muted small mb-0">
                            These rules come from <code>Properties/passwordOptions.json</code>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
