@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">Fast internet for every home</h1>
    <p class="lead text-muted mb-4">
        Comunication_LTD has connected Israeli homes and businesses since 1998.
        Fibre, cable and mobile broadband on one bill.
    </p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-primary btn-lg px-4 me-2" asp-controller="Account" asp-action="Register">Join us</a>
        <a class="btn btn-outline-secondary btn-lg px-4" asp-controller="Account" asp-action="Login">Sign in</a>
    }
</div>

<h2 class="h4 fw-bold mb-3">Our packages</h2>
<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="h5 fw-semibold">Home Basic</h3>
                <p class="display-6 fw-bold mb-1">100<span class="fs-6 fw-normal text-muted"> Mbps</span></p>
                <p class="text-muted small mb-0">Fibre to the building. Free router. Good for 1-3 devices.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <h3 class="h5 fw-semibold">Home Plus</h3>
                <p class="display-6 fw-bold mb-1">500<span class="fs-6 fw-normal text-muted"> Mbps</span></p>
                <p class="text-muted small mb-0">Our most popular plan. Free installation and a mesh unit.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="h5 fw-semibold">Business Fibre</h3>
                <p class="display-6 fw-bold mb-1">1000<span class="fs-6 fw-normal text-muted"> Mbps</span></p>
                <p class="text-muted small mb-0">Symmetric upload, fixed IP address and 24/7 support.</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <h2 class="h5 fw-bold">About us</h2>
        <p class="text-muted">
            We serve private homes, small businesses and the public sector across
            the country, with our own fibre network and a support centre in Haifa.
        </p>
    </div>
    <div class="col-md-6">
        <h2 class="h5 fw-bold">Contact</h2>
        <p class="text-muted mb-0">
            Sales 1-800-555-100<br />
            Support 1-800-555-200<br />
            info@@comltd.co.il
        </p>
    </div>
</div>
