@{
    ViewData["Title"] = "Home";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h1 class="h3 fw-bold mb-1">Welcome, @User.Identity!.Name</h1>
                <p class="text-muted mb-0">Communication LTD customer management.</p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-semibold">Customers</h2>
                        <p class="text-muted small">
                            @ViewBag.CustomerCount customer(s) on record.
                        </p>
                        <a class="btn btn-primary btn-sm" asp-controller="Customers" asp-action="Index">Manage customers</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-semibold">Your account</h2>
                        <p class="text-muted small">Change the password you use to sign in.</p>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="ChangePassword">Change password</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
