@{
    ViewData["Title"] = "Verify code";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark">Enter verification code</h2>
                    <p class="text-muted small mb-0">
                        Check your inbox for the code we sent, then enter it below to continue.
                    </p>
                </div>

                <partial name="_Alerts" />

                <form method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="resetCode" class="form-label text-secondary small fw-semibold">Verification code</label>
                        <input type="text" class="form-control font-monospace" id="resetCode" name="resetCode" required
                               maxlength="40" minlength="40" autocomplete="one-time-code"
                               placeholder="40-character SHA-1 code">
                        <div class="invalid-feedback">The code is 40 characters long.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Verify and continue</button>
                </form>

                <div class="d-flex justify-content-between small mt-4">
                    <a asp-action="ForgotPassword" class="text-decoration-none">Send a new code</a>
                    <a asp-action="Login" class="text-decoration-none text-muted">Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
</div>
