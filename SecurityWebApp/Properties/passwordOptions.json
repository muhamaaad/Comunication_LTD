{
  "PasswordRules": {
    "RequiredLength": 10,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "AllowedSpecialCharacters": "!@#$%^&*()_+{}|[].?",
    "PasswordHistoryLimit": 3,
    "PreventDictionary": true,
    "LoginAttemptLimit": 3
  },
  "UsernameRules": {
    "MinLength": 3,
    "MaxLength": 50,
    "AllowLetters": true,
    "AllowDigits": true,
    "AllowedSpecialCharacters": "._-<>()[]{}/\\=:;!#$%^&*+?|~@ '\""
  }
}
